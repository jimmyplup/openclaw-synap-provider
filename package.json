{
  "name": "openclaw-synap-provider",
  "version": "1.0.0",
  "description": "Synap model provider plugin for OpenClaw.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/jimmyplup/openclaw-synap-provider"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "openclaw": ">=2026.9.4"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  },
  "openclaw": {
    "extensions": ["./src/index.ts"],
    "runtimeExtensions": ["./dist/index.js"],
    "compat": {
      "pluginApi": ">=2026.9.4",
      "minGatewayVersion": "2026.9.4"
    },
    "build": {
      "openclawVersion": "2026.9.4",
      "pluginSdkVersion": "2026.9.4"
    },
    "install": {
      "clawhubSpec": "clawhub:jimmyplup/openclaw-synap-provider",
      "defaultChoice": "clawhub",
      "minHostVersion": ">=2026.9.4"
    },
    "release": {
      "publishToClawHub": true,
      "publishToNpm": false
    }
  },
  "files": [
    "dist/**",
    "openclaw.plugin.json",
    "README.md",
    "LICENSE"
  ]
}
